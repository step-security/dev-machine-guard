[
  {
    "name": "literal",
    "template": "asset-12345",
    "serial": "SER1",
    "hostname": "AVD-HOST-07",
    "user": "jdoe",
    "goos": "windows",
    "expect_id": "asset-12345"
  },
  {
    "name": "literal_kept_verbatim",
    "template": "Asset 12345!",
    "serial": "SER1",
    "hostname": "h",
    "user": "u",
    "goos": "windows",
    "expect_id": "Asset 12345!"
  },
  {
    "name": "hostname",
    "template": "{hostname}",
    "serial": "SER1",
    "hostname": "AVD-HOST-07",
    "user": "jdoe",
    "goos": "windows",
    "expect_id": "avd-host-07"
  },
  {
    "name": "serial_token_kept_verbatim_then_sanitized",
    "template": "{serial}",
    "serial": "VMware-56 4d 1a",
    "hostname": "h",
    "user": "jdoe",
    "goos": "linux",
    "expect_id": "VMware-56-4d-1a"
  },
  {
    "name": "token_case_insensitive",
    "template": "{HOSTNAME}",
    "serial": "SER1",
    "hostname": "Host1",
    "user": "jdoe",
    "goos": "windows",
    "expect_id": "host1"
  },
  {
    "name": "collapse_and_trim",
    "template": "--{hostname}--.",
    "serial": "SER1",
    "hostname": "h1",
    "user": "jdoe",
    "goos": "linux",
    "expect_id": "h1"
  },
  {
    "name": "empty_hostname_falls_back_to_serial",
    "template": "{hostname}",
    "serial": "SER1",
    "hostname": "",
    "user": "jdoe",
    "goos": "linux",
    "expect_id": "SER1"
  },
  {
    "name": "empty_hostname_and_unusable_serial_is_incomplete",
    "template": "{hostname}",
    "serial": "unknown",
    "hostname": "",
    "user": "jdoe",
    "goos": "linux",
    "expect_incomplete": true
  }
]
